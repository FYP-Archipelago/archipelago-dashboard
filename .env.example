# Current Python backend, used by Vite's local /backend proxy.
# For npm start, export this variable in the shell (Node does not load .env).
ARCHIPELAGO_BACKEND_URL=http://127.0.0.1:8000

# Optional: call the backend directly instead of the local proxy.
# Requires that backend's CORS policy to allow the dashboard origin.
# VITE_BACKEND_URL=http://127.0.0.1:8000
